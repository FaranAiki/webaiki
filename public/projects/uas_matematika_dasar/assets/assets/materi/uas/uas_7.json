{
  "type": "doc",
  "content": [
    {
      "type": "heading",
      "attrs": { "level": 1, "textAlign": "center" },
      "content": [{ "type": "text", "text": "Pembuktian: Integral Trigonometri" }]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "text": "Kita tahu bahwa integral adalah kebalikan dari turunan. Untuk membuktikan rumus integral trigonometri, kita cukup melihat tabel turunan." }
      ]
    },
    {
      "type": "accumulationGraph",
      "attrs": {
        "widget": {
          "title": "Dari $cos(x)$ menjadi $sin(x)$",
          "function": "cos(x)",
          "goal": {
            "prompt": "Geser slider x ke kanan. Perhatikan garis hijau (kemiringan) pada grafik A(x). Nilainya SAMA dengan tinggi grafik f(t) saat itu!",
            "type": "interaction",
            "successMessage": "Aha! Kamu baru saja melihat bukti visual bahwa Turunan dari Integral adalah Fungsi itu sendiri.",
            "failedMessage": "Coba geser slidernya lebih jauh lagi untuk melihat pola perubahannya.",
            "lockOnAchieved": true
          }
        }
      }
    },
    {
      "type": "heading",
      "attrs": { "level": 2 },
      "content": [{ "type": "text", "text": "1. Integral Cosinus" }]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "text": "Ingat kembali turunan dari fungsi " },
        { "type": "text", "text": "$\\sin(x)$", "marks": [{ "type": "code" }] },
        { "type": "text", "text": ":" }
      ]
    },
    {
      "type": "paragraph",
      "attrs": { "textAlign": "center", "style": "font-size: 1.2em;" },
      "content": [{ "type": "text", "text": "$\\frac{d}{dx}(\\sin x) = \\cos x$" }]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "text": "Dengan membalik persamaan ini (integralkan kedua ruas), kita langsung mendapatkan:" }
      ]
    },
    {
      "type": "paragraph",
      "attrs": { "textAlign": "center", "style": "font-weight: bold; font-size: 1.2em;" },
      "content": [{ "type": "text", "text": "$\\int \\cos x \\, dx = \\sin x + C$" }]
    },
    {
      "type": "heading",
      "attrs": { "level": 2 },
      "content": [{ "type": "text", "text": "2. Integral Sinus (Hati-hati Tanda Negatif!)" }]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "text": "Sekarang ingat turunan dari " },
        { "type": "text", "text": "$\\cos(x)$", "marks": [{ "type": "code" }] },
        { "type": "text", "text": ":" }
      ]
    },
    {
      "type": "paragraph",
      "attrs": { "textAlign": "center", "style": "font-size: 1.2em;" },
      "content": [{ "type": "text", "text": "$\\frac{d}{dx}(\\cos x) = -\\sin x$" }]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "text": "Kita ingin mencari integral dari " },
        { "type": "text", "text": "positif $\\sin x$", "marks": [{ "type": "bold" }] },
        { "type": "text", "text": ". Pindahkan tanda negatif ke ruas kiri:" }
      ]
    },
    {
      "type": "paragraph",
      "attrs": { "textAlign": "center" },
      "content": [{ "type": "text", "text": "$\\frac{d}{dx}(-\\cos x) = \\sin x$" }]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "text": "Integralkan kedua ruas, maka:" }
      ]
    },
    {
      "type": "paragraph",
      "attrs": { "textAlign": "center", "style": "font-weight: bold; font-size: 1.2em;" },
      "content": [{ "type": "text", "text": "$\\int \\sin x \\, dx = -\\cos x + C$" }]
    },
    {
      "type": "colorBlock",
      "attrs": { "colorBlockType": "tips-card" },
      "content": [
        {
          "type": "heading",
          "attrs": { "level": 3 },
          "content": [{ "type": "text", "text": "Jembatan Keledai" }]
        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "text": "Integral " },
            { "type": "text", "text": "S", "marks": [{ "type": "bold" }] },
            { "type": "text", "text": "inus hasilnya " },
            { "type": "text", "text": "S", "marks": [{ "type": "bold" }] },
            { "type": "text", "text": "edih (negatif). Integral Cosinus hasilnya Cinta (positif)." }
          ]
        }
      ]
    },
    {
      "type": "match",
      "attrs": {
        "widget": {
          "title": "Pasangan Turunan & Integral",
          "elements_title": ["Operasi", "Hasil"],
          "elements": [
            ["$\\frac{d}{dx}(\\sin x)$", "$\\int \\cos x dx$", "$\\frac{d}{dx}(\\cos x)$", "$\\int \\sin x dx$"],
            ["$\\cos x$", "$\\sin x + C$", "$-\\sin x$", "$-\\cos x + C$"]
          ],
          "goal": {
            "prompt": "Cocokkan operasi di kiri dengan hasilnya di kanan!",
            "condition": {
              "edges": [
                [[0, 0], [1, 0]],
                [[0, 1], [1, 1]],
                [[0, 2], [1, 2]],
                [[0, 3], [1, 3]]
              ]
            },
            "successMessage": "Sempurna! Kamu sudah paham pola tanda positif/negatifnya.",
            "failedMessage": "Hati-hati dengan tanda negatif! Turunan cos itu min sin, tapi integral sin itu min cos.",
            "lockOnAchieved": true
          }
        }
      }
    }
  ]
}
