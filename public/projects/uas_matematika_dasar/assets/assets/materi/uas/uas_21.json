      "type": "heading",
      "attrs": {
        "level": 1,
        "textAlign": "center"
      },
      "content": [
        {
          "type": "text",
          "text": "Fungsi Eksponensial Alam ($e^x$)"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Kita sudah kenal logaritma natural "
        },
        {
          "type": "text",
          "text": "$\\ln x$",
          "marks": [
            {
              "type": "code"
            }
          ]
        },
        {
          "type": "text",
          "text": ". Karena "
        },
        {
          "type": "text",
          "text": "$\\ln x$",
          "marks": [
            {
              "type": "code"
            }
          ]
        },
        {
          "type": "text",
          "text": " adalah fungsi satu-satu (selalu naik), maka dia pasti punya invers. Inversnya kita sebut "
        },
        {
          "type": "text",
          "text": "Fungsi Eksponensial Alam",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "type": "text",
          "text": ", ditulis "
        },
        {
          "type": "text",
          "text": "$exp(x)$",
          "marks": [
            {
              "type": "code"
            }
          ]
        },
        {
          "type": "text",
          "text": " atau "
        },
        {
          "type": "text",
          "text": "$e^x$",
          "marks": [
            {
              "type": "code"
            }
          ]
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    },
    {
      "type": "colorBlock",
      "attrs": {
        "colorBlockType": "definisi-card"
      },
      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Definisi e"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Bilangan "
            },
            {
              "type": "text",
              "text": "$e$",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " adalah bilangan real unik yang memenuhi "
            },
            {
              "type": "text",
              "text": "$\\ln(e) = 1$",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": ". Nilainya kira-kira "
            },
            {
              "type": "text",
              "text": "2.71828...",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": "center"
          },
          "content": [
            {
              "type": "text",
              "text": "$y = e^x \\iff x = \\ln y$"
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Keajaiban Turunan e^x"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Fungsi "
        },
        {
          "type": "text",
          "text": "$e^x$",
          "marks": [
            {
              "type": "code"
            }
          ]
        },
        {
          "type": "text",
          "text": " adalah satu-satunya fungsi (selain fungsi nol) yang "
        },
        {
          "type": "text",
          "text": "turunannya adalah dirinya sendiri",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "type": "text",
          "text": "! Artinya, kemiringan grafik di titik mana pun sama dengan tinggi grafik di titik itu."
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "textAlign": "center",
        "style": "font-size: 1.2em; font-weight: bold;"
      },
      "content": [
        {
          "type": "text",
          "text": "$\\frac{d}{dx} (e^x) = e^x$"
        }
      ]
    },
    {
      "type": "interactive_graph",
      "attrs": {
        "widget": {
          "title": "Visualisasi Kemiringan e^x",
          "viewport": {
            "bounds": {
              "xMin": -2,
              "xMax": 2,
              "yMin": 0,
              "yMax": 8
            }
          },
          "expressions": [
            {
              "formula": "2.71828^x",
              "color": 4280391411,
              "thickness": 3,
              "style": "solid"
            },
            {
              "formula": "2.71828^a * (x - a + 1)",
              "color": 4294901760,
              "style": "dashed",
              "thickness": 2
            }
          ],
          "variable": {
            "a": {
              "value": 1,
              "min": -2,
              "max": 2,
              "step": 0.1,
              "static": false
            }
          },
          "goal": {
            "prompt": "Garis putus-putus adalah garis singgung di x=1. Perhatikan bahwa kemiringannya (gradien) sama persis dengan nilai fungsi di titik itu (sekitar 2.718).",
            "type": "interaction",
            "successMessage": "Inilah alasan kenapa e^x sangat penting dalam model pertumbuhan populasi!",
            "failedMessage": "Perhatikan grafik biru (fungsi) dan merah (garis singgung).",
            "lockOnAchieved": true
          }
        }
      }
    },
    {
      "type": "match",
      "attrs": {
        "widget": {
          "title": "Sifat Eksponen vs Logaritma",
          "elements_title": [
            "Operasi Logaritma",
            "Operasi Eksponen"
          ],
          "elements": [
            [
              "$\\ln(ab) = \\ln a + \\ln b$",
              "$\\ln(a/b) = \\ln a - \\ln b$",
              "$\\ln(a^r) = r \\ln a$",
              "$\\ln(e) = 1$"
            ],
            [
              "$e^{x+y} = e^x e^y$",
              "$e^{x-y} = e^x / e^y$",
              "$(e^x)^r = e^{rx}$",
              "$e^1 = e$"
            ]
          ],
          "goal": {
            "prompt": "Pasangkan sifat logaritma dengan sifat eksponen yang bersesuaian!",
            "condition": {
              "edges": [
                [
                  [0, 0],
                  [1, 0]
                ],
                [
                  [0, 1],
                  [1, 1]
                ],
                [
                  [0, 2],
                  [1, 2]
                ],
                [
                  [0, 3],
                  [1, 3]
                ]
              ]
            },
            "successMessage": "Sempurna! Sifat-sifat ini saling terkait karena mereka adalah fungsi invers.",
            "failedMessage": "Ingat: Perkalian di logaritma jadi penjumlahan, di eksponen perkalian basis jadi penjumlahan pangkat.",
            "lockOnAchieved": true
          }
        }
      }
    }
  ]
}
